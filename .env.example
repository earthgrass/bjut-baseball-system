# POWER ARENA 环境变量示例
# 复制为 .env 并填入实际值（.env 已在 .gitignore 中，不会被提交）

# Flask
FLASK_ENV=development          # development | production
FLASK_DEBUG=0                  # 0 | 1（生产必须 0）
SECRET_KEY=                    # 必填，至少 32 字符的随机串：
                                #   python -c "import secrets; print(secrets.token_hex(32))"

# 数据库
# 相对路径 → 相对 instance/ 解析（即 instance/baseball_players.db）
# 绝对路径 → 直接使用（测试隔离、外部挂载的持久化目录都用这个）
DATABASE_FILE=baseball_players.db
INIT_DEFAULT_ADMIN=1           # 首次启动创建默认 admin（账号已存在时不会覆盖密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                # 留空则首次启动随机生成并打印到 stdout
                                # 改密码请用：python scripts/reset_admin_password.py

# 速率限制（每分钟）
RATELIMIT_LOGIN=5/minute
RATELIMIT_API=60/minute

# Matplotlib 缓存（可选）
MPLCONFIGDIR=instance/matplotlib-cache